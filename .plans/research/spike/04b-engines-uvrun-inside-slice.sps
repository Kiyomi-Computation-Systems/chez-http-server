;; E4b: (uv-run loop 'nowait) called from INSIDE an engine slice, with a timer
;; callback that does enough Scheme work for the engine to expire while the
;; callback (a foreign-callable frame under uv_run) is on the stack.
;; Modes (argv[1]): resume-immediately | uvrun-then-resume | engine-block
(import (rnrs) (libuv)
        (only (chezscheme) printf make-engine engine-block display-condition command-line))
(define (log! fmt . args) (apply printf fmt args) (flush-output-port (current-output-port)))
(define (show e) (call-with-string-output-port (lambda (p) (display-condition e p))))
(define mode (string->symbol (cadr (command-line))))
(log! "mode: ~a\n" mode)
(define loop (make-uv-loop))
(define (busy n) (let f ((i 0) (acc 0)) (if (< i n) (f (+ i 1) (+ acc i)) acc)))
(define cb-log '())
(define (cb-log! x) (set! cb-log (cons x cb-log)))
(define t (make-uv-timer loop))
(uv-timer-start! t
  (lambda (tm)
    (cb-log! 'cb-enter)
    (if (eq? mode 'engine-block)
        (begin (cb-log! 'cb-calls-engine-block) (engine-block) (cb-log! 'cb-after-engine-block))
        (begin (busy 3000000) (cb-log! 'cb-after-busy)))
    (uv-close! t)
    (cb-log! 'cb-exit))
  0 0)
(define e (make-engine
            (lambda ()
              (cb-log! 'slice-enter)
              (let ((rc (uv-run loop 'nowait)))
                (cb-log! (list 'uv-run-returned rc))
                'engine-done))))
(define expiries 0)
(define outcome
  (guard (x (#t (log! "TOP-LEVEL guard caught: ~a\n" (show x)) (list 'raised (show x))))
    (let run ((e e))
      (e 100
         (lambda (tl . v) (list 'completed v))
         (lambda (e2)
           (set! expiries (+ expiries 1))
           (cb-log! (list 'expired expiries))
           (cond ((> expiries 5) 'gave-up-after-5-expiries)
                 ((eq? mode 'uvrun-then-resume)
                  (cb-log! 'outer-uv-run-nowait)
                  (let ((r (guard (y (#t (list 'outer-uv-run-raised (show y)))) (uv-run loop 'nowait))))
                    (cb-log! (list 'outer-uv-run-result r)))
                  (run e2))
                 (else (run e2))))))))
(log! "outcome: ~s\n" outcome)
(log! "cb-log: ~s\n" (reverse cb-log))
(log! "deferred-errors: ~s\n" (guard (x (#t (list 'raised (show x)))) (map show (uv-loop-deferred-errors loop))))
(log! "live handles: ~a\n" (length (uv-loop-live-handles loop)))
(guard (x (#t (log! "teardown RAISED: ~a\n" (show x)))) (uv-loop-teardown! loop))
(log! "teardown done; loop-open? ~s\n" (uv-loop-open? loop))
