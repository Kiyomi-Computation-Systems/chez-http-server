;; E2b: full call/cc captured inside a timer callback, returned normally; invoked
;; from TOP LEVEL after uv-run has returned (loop open, not running).
(import (rnrs) (libuv)
        (only (chezscheme) printf display-condition))
(define (log! fmt . args) (apply printf fmt args) (flush-output-port (current-output-port)))
(define (show e) (call-with-string-output-port (lambda (p) (display-condition e p))))
(define loop (make-uv-loop))
(define stash #f)
(define t1-entries 0)
(define t1 (make-uv-timer loop))
(uv-timer-start! t1
  (lambda (t)
    (set! t1-entries (+ t1-entries 1))
    (log! "t1: fired (entry #~a); capturing call/cc\n" t1-entries)
    (let ((v (call/cc (lambda (k) (set! stash k) 'first-time))))
      (log! "t1: call/cc returned ~s; returning normally to libuv\n" v))
    (uv-close! t1))
  10 0)
(define rc (guard (e (#t (log! "uv-run RAISED: ~a\n" (show e)) 'raised)) (uv-run loop 'default)))
(log! "uv-run returned ~s; now at top level, loop open, not running\n" rc)
(define invoked #f)
(unless invoked
  (set! invoked #t)
  (log! "top: invoking stashed k with 'from-top (unguarded)\n")
  (stash 'from-top)
  (log! "top: statement after (stash 'from-top) reached\n"))
(log! "top: continuing after the invoke block; t1-entries ~a\n" t1-entries)
(guard (e (#t (log! "teardown RAISED: ~a\n" (show e)))) (uv-loop-teardown! loop))
(log! "teardown done; loop-open? ~s\n" (uv-loop-open? loop))
