#!r6rs
(import (rnrs) (generated httparse-message) (httparse modes) (byte-machine runtime))
(define (mk type)
  (let ((mc 0))
    (define (ev name) (lambda (p ctx) (when (eq? name 'on-message-complete) (set! mc (+ mc 1))) callback-continue))
    (define (sp name) (lambda (p ctx bv from to) callback-continue))
    (define spans '(on-method-data on-url-data on-protocol-data on-version-data on-status-data on-header-field-data on-header-value-data on-body-data on-chunk-extension-name-data on-chunk-extension-value-data))
    (define evs '(on-method-complete on-url-complete on-protocol-complete on-version-complete on-status-complete on-header-field-complete on-header-value-complete on-chunk-extension-name-complete on-chunk-extension-value-complete on-message-begin on-headers-complete on-chunk-header on-chunk-complete on-message-complete on-reset))
    (values (make-parser httparse-message-machine (append (map (lambda (n) (list n (sp n))) spans) (map (lambda (n) (list n (ev n))) evs)) #f
              (list (cons 'type (httparse-message-type-value type)) (cons 'lenient-flags (httparse-lenient-flags-value '()))))
            (lambda () mc))))
(define (run label type input)
  (let-values (((p mc) (mk type)))
    (let* ((bv (string->utf8 input)) (r (parser-feed! p bv 0 (bytevector-length bv))) (f (parser-finish! p)))
      (display (list label 'feed (parser-result-status r) 'finish (parser-result-status f) 'finish-field (parser-field-ref p 'finish) 'message-complete-count (mc))) (newline))))
(run "A close-delimited response body:" 'response "HTTP/1.1 200 OK\r\n\r\nhello world")
(run "B idle parser, no input at all:  " 'response "")
(run "C complete request then EOF:     " 'request "GET / HTTP/1.1\r\nHost: x\r\n\r\n")
(run "D EOF mid-header (unsafe):       " 'request "GET / HTTP/1.1\r\nHos")
