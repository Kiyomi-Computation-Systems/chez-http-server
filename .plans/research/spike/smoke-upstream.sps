#!r6rs
(import (rnrs) (httparse decisions) (httparse methods) (uri collect) (uri components))
(define (show . xs) (for-each (lambda (x) (display x) (display " ")) xs) (newline))
(define (ka maj min type st fl) (should-keep-alive? maj min type st fl))
(show "keep-alive quadrants (expect #f #t #t #f #t #f):"
      (ka 1 0 'request 0 0) (ka 1 0 'request 0 F-CONNECTION-KEEP-ALIVE)
      (ka 1 1 'request 0 0) (ka 1 1 'request 0 F-CONNECTION-CLOSE)
      (ka 1 2 'request 0 0) (ka 2 0 'request 0 0))
(show "needs-eof (expect #f #t #f #f #f):"
      (message-needs-eof? 'request 200 0)
      (message-needs-eof? 'response 200 0)
      (message-needs-eof? 'response 204 0)
      (message-needs-eof? 'response 200 F-SKIP-BODY)
      (message-needs-eof? 'response 200 F-CONTENT-LENGTH))
(show "flags:" F-CONNECTION-KEEP-ALIVE F-CONNECTION-CLOSE F-SKIP-BODY F-TRANSFER-ENCODING)
(show "methods:" (httparse-method-name 1) (httparse-method-name 5) (httparse-method-number 'CONNECT) (httparse-method-number 'HEAD))
(define (auth bv) (let ((r (uri-parse-authority-form bv)))
  (if (uri-parse-ok? r) (list 'ok (utf8->string (uri-components-authority (uri-parse-components r))))
      (list 'err (uri-parse-error-code r) (uri-parse-error-offset r)))))
(define (authv bv) (let ((r (uri-parse-authority-form-validate bv)))
  (if (uri-parse-ok? r) 'ok (list 'err (uri-parse-error-code r) (uri-parse-error-offset r)))))
(show "authority-form lenient:" (auth (string->utf8 "example.com:443")) (auth (string->utf8 "example.com:443/x")))
(show "authority-form strict:" (authv (string->utf8 "example.com:443")) (authv (string->utf8 "u@example.com:443")) (authv (string->utf8 "example.com:")) (authv (string->utf8 "[::1]:8443")))
(define (val bv) (let ((r (uri-parse-validate 'uri bv)))
  (if (uri-parse-ok? r) 'ok (list 'err (uri-parse-error-code r) (uri-parse-error-offset r)))))
(show "validate host with CR (expect err):" (val (string->utf8 "http://exa\rmple.com/p")))
(show "validate host with SP (expect err):" (val (string->utf8 "http://exa mple.com/p")))
(show "validate clean (expect ok):" (val (string->utf8 "http://example.com/p?q=1")))
