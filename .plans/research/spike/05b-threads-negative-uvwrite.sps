;; E5b (NEGATIVE): the WORKER thread calls uv-write! directly on a handle owned
;; by the loop thread while the loop thread is inside uv-run. Expected: undefined
;; behaviour; whatever happens is the finding.
(import (rnrs) (libuv)
        (only (chezscheme) printf fork-thread sleep make-time display-condition real-time get-thread-id))
(define (log! fmt . args) (apply printf fmt args) (flush-output-port (current-output-port)))
(define (show e) (call-with-string-output-port (lambda (p) (display-condition e p))))
(define (span->bv bv s e) (let ((o (make-bytevector (- e s)))) (bytevector-copy! bv s o 0 (- e s)) o))
(define loop (make-uv-loop))
(define server (make-uv-tcp loop))
(uv-tcp-bind! server "127.0.0.1" 0)
(define port (uv-tcp-getsockname-port server))
(define received 0)
(define peer #f)
(uv-listen! server 128
  (lambda (err)
    (unless err
      (set! peer (uv-accept! server))
      (uv-read-start! peer
        (lambda (bv s e) (set! received (+ received (- e s))))
        (lambda () (log! "peer eof\n"))
        (lambda (e) (log! "peer error ~a\n" (show e)))))))
(define client (make-uv-tcp loop))
(define connected #f)
(uv-tcp-connect! client "127.0.0.1" port (lambda (e) (set! connected #t) (log! "client connected err=~s\n" e)))
(define keepalive (make-uv-timer loop))
(define ticks 0)
(uv-timer-start! keepalive (lambda (t) (set! ticks (+ ticks 1))) 1 1)
(define worker-done #f)
(define worker-log '())
(define stop (make-uv-timer loop))
(uv-timer-start! stop
  (lambda (t)
    (log! "stop timer: ticks ~a received-bytes ~a worker-done ~s\n" ticks received worker-done)
    (for-each (lambda (h) (when (uv-handle-open? h) (uv-close! h))) (list keepalive stop server client))
    (when (and peer (uv-handle-open? peer)) (uv-close! peer)))
  1500 0)
(log! "main thread id ~a; forking worker that will call uv-write! from its own thread\n" (get-thread-id))
(fork-thread
  (lambda ()
    (log! "worker thread id ~a: started; waiting for connect\n" (get-thread-id))
    (let wait () (unless connected (sleep (make-time 'time-duration 5000000 0)) (wait)))
    (let f ((i 0))
      (when (< i 200)
        (guard (e (#t (log! "worker: uv-write! #~a RAISED: ~a\n" i (show e))))
          (uv-write! client (string->utf8 (format "w~a;" i)) (lambda (e) (set! worker-log (cons (cons i e) worker-log)))))
        (sleep (make-time 'time-duration 1000000 0))
        (f (+ i 1))))
    (set! worker-done #t)
    (log! "worker: finished 200 direct uv-write! calls\n")))
(define rc (guard (e (#t (log! "uv-run RAISED: ~a\n" (show e)) 'raised)) (uv-run loop 'default)))
(log! "uv-run returned ~s; ticks ~a received-bytes ~a write-completions ~a\n" rc ticks received (length worker-log))
(guard (e (#t (log! "teardown RAISED: ~a\n" (show e)))) (uv-loop-teardown! loop))
(log! "teardown done; loop-open? ~s\n" (uv-loop-open? loop))
