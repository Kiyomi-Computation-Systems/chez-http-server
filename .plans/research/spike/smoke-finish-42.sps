#!r6rs
(import (rnrs) (generated httparse-message) (httparse modes) (byte-machine runtime))
(define (mk type)
  (define (ev name) (lambda (p ctx) callback-continue))
  (define (sp name) (lambda (p ctx bv from to) callback-continue))
  (define spans '(on-method-data on-url-data on-protocol-data on-version-data on-status-data on-header-field-data on-header-value-data on-body-data on-chunk-extension-name-data on-chunk-extension-value-data))
  (define evs '(on-method-complete on-url-complete on-protocol-complete on-version-complete on-status-complete on-header-field-complete on-header-value-complete on-chunk-extension-name-complete on-chunk-extension-value-complete on-message-begin on-headers-complete on-chunk-header on-chunk-complete on-message-complete on-reset))
  (make-parser httparse-message-machine (append (map (lambda (n) (list n (sp n))) spans) (map (lambda (n) (list n (ev n))) evs)) #f
    (list (cons 'type (httparse-message-type-value type)) (cons 'lenient-flags (httparse-lenient-flags-value '())))))
(define (err-of r)
  (let ((e (parser-result-error r)))
    (if e (list (parser-error-code e) (parser-error-reason e)) '-)))
(define (finish-probe label input)
  (let* ((p (mk 'request)) (bv (string->utf8 input))
         (r (parser-feed! p bv 0 (bytevector-length bv))) (f (parser-finish! p)))
    (display (list label 'feed (parser-result-status r) 'finish-field (parser-field-ref p 'finish)
                   'finish (parser-result-status f) (err-of f))) (newline)))
(define (feed-probe label input)
  (let* ((p (mk 'request)) (bv (string->utf8 input))
         (r (parser-feed! p bv 0 (bytevector-length bv))))
    (display (list label 'feed (parser-result-status r) 'at (parser-result-consumed r) (err-of r))) (newline)))
(display "--- parser-finish! from an UNSAFE state") (newline)
(finish-probe "D mid-header-field  GET / HTTP/1.1\\r\\nHos            " "GET / HTTP/1.1\r\nHos")
(finish-probe "E finish.md#2 mid-header-value (finish=2)          " "PUT / HTTP/1.1\r\nContent-Length: 100")
(finish-probe "F finish.md#3 mid-header-field (finish=2)          " "PUT / HTTP/1.1\r\nContent-Leng")
(finish-probe "G mid-method  GE                                   " "GE")
(finish-probe "H mid-body    PUT / HTTP/1.1\\r\\nContent-Length: 5\\r\\n\\r\\nab" "PUT / HTTP/1.1\r\nContent-Length: 5\r\n\r\nab")
(display "--- feed only: can the URL sub-machine answer unexpected-eof without a finish?") (newline)
(feed-probe "U1 GET http HTTP/1.1     " "GET http HTTP/1.1\r\n\r\n")
(feed-probe "U2 GET http:/ HTTP/1.1   " "GET http:/ HTTP/1.1\r\n\r\n")
(feed-probe "U3 GET http:// HTTP/1.1  " "GET http:// HTTP/1.1\r\n\r\n")
(feed-probe "U4 GET http://h@ HTTP/1.1" "GET http://h@ HTTP/1.1\r\n\r\n")
(feed-probe "U5 GET http://h: HTTP/1.1" "GET http://h: HTTP/1.1\r\n\r\n")
