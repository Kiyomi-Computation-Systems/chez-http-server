#!/bin/sh
# Runs INSIDE the container, as the first command scripts/guix-env starts.
# Exports what the Makefile and the suites take from the profile, then
# runs the command:
#
#   CHEZ  the profile's scheme: the Makefile's default, `chez`, is not in
#         the profile, and a symlink named chez breaks Chez's boot-file
#         lookup. tests/test-examples.sps starts each example with it too.
#   CC    the profile's gcc: gcc-toolchain installs no cc. chez-libuv's
#         shim and vtest2 are built with it.
#
# It sets no LD_LIBRARY_PATH. chez-libuv's shim records libuv's absolute
# path, and pkg-config finds libuv through the PKG_CONFIG_PATH the profile
# sets.
set -eu

die() { printf 'guix-env-enter: %s\n' "$*" >&2; exit 2; }

if [ -z "${GUIX_ENVIRONMENT:-}" ]; then
  die "not inside a Guix environment; use scripts/guix-env"
fi

# need FILE: dies unless FILE is a regular file, or a symlink to one.
need() {
  [ -f "$1" ] || die "no $1 in the profile; is its package in manifest.scm?"
}

need "$GUIX_ENVIRONMENT/bin/scheme"
need "$GUIX_ENVIRONMENT/bin/gcc"
need "$GUIX_ENVIRONMENT/lib/pkgconfig/libuv.pc"

export CHEZ="$GUIX_ENVIRONMENT/bin/scheme"
export CC="$GUIX_ENVIRONMENT/bin/gcc"

exec "$@"
