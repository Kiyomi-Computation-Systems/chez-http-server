vtest "A version that is not 1.x is answered 505, HTTP/1.x is served as 1.1, and one the parser cannot read is a 400"
# A request line with no version reads as HTTP/0.9, its head ended by an
# empty line, and is answered 505, as are HTTP/2.0, HTTP/3.0 and every other
# version that is not 1.x; the HTTP/2 preface is answered 505 on the parser's
# error channel.  A 1.x past 1.1, such as HTTP/1.2, is served as HTTP/1.1 and
# kept alive (RFC 9110 §6.2).  A version the parser cannot read, HTTP/1.x, is
# its error, 400.  Every status the server originates closes the connection.
client c1 -connect "${host} ${port}" {
    send "GET /\r\n\r\n"
    rxresp
    expect resp.status == 505
    expect resp.http.Connection == "close"
    expect_close
} -run
client c2 -connect "${host} ${port}" {
    send "GET / HTTP/2.0\r\nHost: x\r\n\r\n"
    rxresp
    expect resp.status == 505
    expect_close
} -run
client c3 -connect "${host} ${port}" {
    send "PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
    rxresp
    expect resp.status == 505
    expect resp.http.Connection == "close"
    expect_close
} -run
client c4 -connect "${host} ${port}" {
    send "GET /a HTTP/1.2\r\nHost: x\r\n\r\n"
    rxresp
    expect resp.status == 200
    expect resp.proto == "HTTP/1.1"
    expect resp.http.Connection == <undef>
    expect resp.body == "/a -\n"
    send "GET /b HTTP/1.9\r\nHost: x\r\n\r\n"
    rxresp
    expect resp.status == 200
    expect resp.body == "/b -\n"
} -run
client c5 -connect "${host} ${port}" {
    send "GET / HTTP/3.0\r\nHost: x\r\n\r\n"
    rxresp
    expect resp.status == 505
    expect resp.http.Connection == "close"
    expect_close
} -run
client c6 -connect "${host} ${port}" {
    send "GET / HTTP/1.x\r\nHost: x\r\n\r\n"
    rxresp
    expect resp.status == 400
    expect_close
} -run
