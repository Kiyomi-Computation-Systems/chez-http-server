vtest "Bracket params and pipes are redirected, encoded; any other method's are refused"
# Decision 0009: a GET or HEAD whose only faults are | in the path and [, ]
# or | in the query is answered 301, Location the target percent-encoded
# in uppercase hex, no content, then the close; any other method's, 400.
client c1 -connect "${host} ${port}" {
    send "GET /a|b?ids[]=1|2 HTTP/1.1\r\nHost: x\r\n\r\n"
    rxresp
    expect resp.status == 301
    expect resp.http.Location == "/a%7Cb?ids%5B%5D=1%7C2"
    expect resp.bodylen == 0
    expect resp.http.Connection == "close"
    expect_close
} -run
client c2 -connect "${host} ${port}" {
    send "POST /a?ids[]=1 HTTP/1.1\r\nHost: x\r\nContent-Length: 0\r\n\r\n"
    rxresp
    expect resp.status == 400
    expect_close
} -run
