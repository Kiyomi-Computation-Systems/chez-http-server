vtest "HEAD: the fields a GET's answer has, and no content"
# RFC 9110 §9.3.2.  Content the server wrongly sent would be read as the
# next response's status line, which its status check then refuses.
client c1 -connect "${host} ${port}" {
    txreq -req HEAD -url "/h"
    rxresp -no_obj
    expect resp.status == 200
    expect resp.http.Content-Length == 5
    txreq -url "/h"
    rxresp
    expect resp.status == 200
    expect resp.http.Content-Length == 5
    expect resp.body == "/h -\n"
} -run
